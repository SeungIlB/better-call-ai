POSTGRES_DB=legal_ai
DATABASE_URL=jdbc:postgresql://localhost:5433/legal_ai
DATABASE_MIGRATION_USER=legal_ai_migrator
DATABASE_MIGRATION_PASSWORD=change-me-migration-password
DATABASE_AUTH_USER=legal_ai_auth
DATABASE_AUTH_PASSWORD=change-me-auth-password
DATABASE_APP_USER=legal_ai_app
DATABASE_APP_PASSWORD=change-me-app-password
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=better-call-ai
JWT_KEY_ID=better-call-ai-local
JWT_PRIVATE_KEY_BASE64=replace-with-base64-pkcs8-private-key
JWT_PUBLIC_KEY_BASE64=replace-with-base64-x509-public-key
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=14d
IDENTITY_ENCRYPTION_KEY_ID=local-v1
IDENTITY_ENCRYPTION_KEY_BASE64=replace-with-base64-32-byte-key
IDENTITY_LOOKUP_KEY_BASE64=replace-with-another-base64-32-byte-key
OBJECT_STORAGE_BUCKET=better-call-ai-local
OCR_PROVIDER=stub
LLM_PROVIDER=stub
LAW_OPEN_DATA_OC=
LAW_OPEN_DATA_CONNECT_TIMEOUT=2s
LAW_OPEN_DATA_READ_TIMEOUT=5s
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
# 미설정이면 추론 옵션 생략. 모델이 지원하는 값만 지정한다.
OPENAI_CHAT_REASONING_EFFORT=
# 추론 토큰을 포함한 출력 예산. 허용 범위 1200~16000.
OPENAI_CHAT_MAX_OUTPUT_TOKENS=1200
# 2026-09-10 OCR 평가 설정. 모델 변경 시 정확도·지연 재평가 필요.
OPENAI_OCR_MODEL=gpt-5.6-sol
OPENAI_OCR_REASONING_EFFORT=none
OPENAI_OCR_TIMEOUT_SECONDS=150
OPENAI_VECTOR_STORE_ID=
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000
